generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  connection_limit = 10
  pool_timeout  = 10
}

enum MeetingStatus {
  CREATED
  LIVE
  ENDED
}

enum ParticipantRole {
  HOST
  PARTICIPANT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  provider  String?
  image     String?
  createdAt DateTime @default(now())
  name      String

  meetings     Meeting[]
  participants MeetingParticipant[]
  messages     ChatMessage[]
}

model Meeting {
  id          String        @id @default(uuid())
  meetingCode String        @unique
  hostId      String
  status      MeetingStatus @default(CREATED)
  createdAt   DateTime      @default(now())
  endedAt     DateTime?

  host         User                 @relation(fields: [hostId], references: [id])
  participants MeetingParticipant[]
  messages     ChatMessage[]

  @@index([hostId])
  @@index([status])
}

model MeetingParticipant {
  id        String          @id @default(uuid())
  meetingId String
  userId    String
  role      ParticipantRole
  joinedAt  DateTime        @default(now())
  leftAt    DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId], name: "meetingId_userId")
  @@index([meetingId])
  @@index([userId])
}

model ChatMessage {
  id           String   @id @default(uuid())
  roomId       String
  userId       String
  name         String
  message      String
  fileMetadata Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([roomId, createdAt])
  @@index([userId])
}
